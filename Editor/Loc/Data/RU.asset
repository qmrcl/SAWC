  PhysicsSettingsGroundedGravity:
    DisplayName: "\u041F\u0440\u0438\u0436\u0438\u043C\u043D\u0430\u044F \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044F"
    Tooltip: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
      \u0441\u0438\u043B\u0430, \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u044E\u0449\u0430\u044F
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430 \u043A \u0437\u0435\u043C\u043B\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043D \u043D\u0435 \u043E\u0442\u043B\u0435\u0442\u0430\u043B
      \u043F\u0440\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0438 \u0432\u043D\u0438\u0437
      \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0430\u043C."
  PhysicsSettingsFallMultiplier:
    DisplayName: "\u041C\u043D\u043E\u0436\u0438\u0442\u0435\u043B\u044C \u043F\u0430\u0434\u0435\u043D\u0438\u044F"
    Tooltip: "\u041A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442,
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0439
      \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044E, \u043A\u043E\u0433\u0434\u0430
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436 \u043B\u0435\u0442\u0438\u0442
      \u0432\u043D\u0438\u0437. \u0414\u0435\u043B\u0430\u0435\u0442 \u043F\u0440\u044B\u0436\u043E\u043A
      \u043C\u0435\u043D\u0435\u0435 \xAB\u043B\u0443\u043D\u043D\u044B\u043C\xBB."
  CrouchSettingsCanCrouch:
    DisplayName: "\u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044C \u043F\u0440\u0438\u0441\u0435\u0434"
    Tooltip: "\u0413\u043B\u043E\u0431\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u044C
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u044C
      \u0432 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043F\u0440\u0438\u0441\u0435\u0434\u0430."
  CrouchSettingsCanJumpWhileCrouching:
    DisplayName: "\u041F\u0440\u044B\u0436\u043E\u043A \u0438\u0437 \u043F\u0440\u0438\u0441\u0435\u0434\u0430"
    Tooltip: "\u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044C \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0443
      \u0441\u043E\u0432\u0435\u0440\u0448\u0430\u0442\u044C \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u044B\u0439
      \u043F\u0440\u044B\u0436\u043E\u043A \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E
      \u0438\u0437 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0441\u0438\u0434\u044F."
  CrouchSettingsCrouchSpeed:
    DisplayName: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0432 \u043F\u0440\u0438\u0441\u0435\u0434\u0435"
    Tooltip: "\u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436
      \u0438\u0434\u0435\u0442 \u043D\u0430 \u043A\u043E\u0440\u0442\u043E\u0447\u043A\u0430\u0445."
  CrouchSettingsStandingHeight:
    DisplayName: "\u0412\u044B\u0441\u043E\u0442\u0430 \u0441\u0442\u043E\u044F"
    Tooltip: "\u0428\u0442\u0430\u0442\u043D\u0430\u044F \u0432\u044B\u0441\u043E\u0442\u0430
      \u043A\u0430\u043F\u0441\u0443\u043B\u044B \u043A\u043E\u043B\u043B\u0430\u0439\u0434\u0435\u0440\u0430
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430 \u0432 \u043F\u043E\u043B\u043D\u044B\u0439
      \u0440\u043E\u0441\u0442."
  CrouchSettingsCrouchHeight:
    DisplayName: "\u0412\u044B\u0441\u043E\u0442\u0430 \u0432 \u043F\u0440\u0438\u0441\u0435\u0434\u0435"
    Tooltip: "\u0426\u0435\u043B\u0435\u0432\u0430\u044F \u0432\u044B\u0441\u043E\u0442\u0430
      \u043A\u0430\u043F\u0441\u0443\u043B\u044B \u043A\u043E\u043B\u043B\u0430\u0439\u0434\u0435\u0440\u0430,
      \u0434\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043E\u043D\u0430
      \u0441\u043E\u0436\u043C\u0435\u0442\u0441\u044F \u043F\u0440\u0438 \u043F\u0440\u0438\u0441\u0435\u0434\u0430\u043D\u0438\u044F\u0445."
  CrouchSettingsEnvironmentMask:
    DisplayName: "\u041C\u0430\u0441\u043A\u0430 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u0439
      \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439"
    Tooltip: "\u0421\u043B\u043E\u0438 \u043A\u043E\u043B\u043B\u0438\u0437\u0438\u0438
      (LayerMask), \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044E\u0442\u0441\u044F
      \u043B\u0443\u0447\u043E\u043C \u0432\u0432\u0435\u0440\u0445 \u043F\u0435\u0440\u0435\u0434
      \u0442\u0435\u043C, \u043A\u0430\u043A \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044C
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0443 \u0432\u0441\u0442\u0430\u0442\u044C
      \u0432 \u043F\u043E\u043B\u043D\u044B\u0439 \u0440\u043E\u0441\u0442."
