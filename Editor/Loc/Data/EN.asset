%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 60691bd447c276440a62364335174adf, type: 3}
  m_Name: EN
  m_EditorClassIdentifier: ::SAWC.Localization::LanguageAsset
  LanguageName: English
  AudioContainerSettingsAvoidRepeatingLast:
    DisplayName: Avoid Repeating Last
    Tooltip: The number of recent clips stored in history to prevent the same sound from playing back-to-back.
  AudioContainerSettingsBasePitch:
    DisplayName: Base Pitch
    Tooltip: The default pitch multiplier applied when playing a clip from this container.
  AudioContainerSettingsBaseVolume:
    DisplayName: Base Volume
    Tooltip: The default volume level applied when playing a clip from this container.
  AudioContainerSettingsClips:
    DisplayName: Audio Clips
    Tooltip: The collection of audio clips used for this specific sound category.
  AudioContainerSettingsPitchRandomization:
    DisplayName: Pitch Randomization
    Tooltip: The maximum random variance added or subtracted from the base pitch to avoid repetitive sound artifacts.
  AudioContainerSettingsPlayback:
    DisplayName: Playback Mode
    Tooltip: The logic used to select the next audio clip from the list (Sequential, Shuffle, or Random).
  AudioContainerSettingsVolumeRandomization:
    DisplayName: Volume Randomization
    Tooltip: The maximum random variance added or subtracted from the base volume for organic variation.
  BaseInputProvider_cameraTransform:
    DisplayName: Camera Transform
    Tooltip: The Transform reference of the camera used to calculate relative movement vectors and look orientation.
  CameraHeightOffset_controller:
    DisplayName: Core Controller
    Tooltip: Reference to the main SAWController component to track crouch states.
  CameraHeightOffset_crouchingHeight:
    DisplayName: Crouch Camera Height
    Tooltip: The local Y-axis position of the camera when the character is fully crouched.
  CameraHeightOffset_smoothTime:
    DisplayName: Height Smooth Time
    Tooltip: The damping time (in seconds) used to smoothly interpolate the camera height between standing and crouching.
  CameraHeightOffset_standingHeight:
    DisplayName: Standing Camera Height
    Tooltip: The default local Y-axis position of the camera when the character is standing upright.
  CameraMotionDynamics_controller:
    DisplayName: Core Controller
    Tooltip: Reference to the main SAWController component to read current physical velocity.
  CameraMotionDynamics_forwardPitchAngle:
    DisplayName: Forward Pitch Angle
    Tooltip: The maximum vertical pitch angle applied to the camera when the character accelerates forward.
  CameraMotionDynamics_forwardSmoothTime:
    DisplayName: Forward Tilt Smooth Time
    Tooltip: The damping time for interpolating the camera's forward pitch effect.
  CameraMotionDynamics_maxForwardSpeed:
    DisplayName: Max Forward Speed
    Tooltip: The character's forward velocity required to reach the maximum forward pitch angle.
  CameraMotionDynamics_maxStrafeSpeed:
    DisplayName: Max Strafe Speed
    Tooltip: The character's lateral velocity required to reach the maximum sideways roll angle.
  CameraMotionDynamics_maxVerticalSpeed:
    DisplayName: Max Vertical Speed
    Tooltip: The character's vertical velocity (falling/jumping) required to reach the maximum vertical pitch angle.
  CameraMotionDynamics_panAngle:
    DisplayName: Strafe Roll Angle
    Tooltip: The maximum lateral roll angle applied to the camera when the character strafes or turns sharply.
  CameraMotionDynamics_panSmoothTime:
    DisplayName: Strafe Roll Smooth Time
    Tooltip: The damping time for interpolating the camera's lateral roll effect.
  CameraMotionDynamics_tiltAngle:
    DisplayName: Lateral Tilt Angle
    Tooltip: The maximum roll angle applied during lateral movement.
  CameraMotionDynamics_tiltSmoothTime:
    DisplayName: Lateral Tilt Smooth Time
    Tooltip: The damping time for returning the camera to its neutral roll state.
  CameraMotionDynamics_verticalPitchAngle:
    DisplayName: Vertical Pitch Angle
    Tooltip: The maximum vertical pitch angle applied when the character is rapidly ascending or falling.
  CameraMotionDynamics_verticalSmoothTime:
    DisplayName: Vertical Tilt Smooth Time
    Tooltip: The damping time for interpolating the camera's vertical pitch effect.
  CameraShakeControl_brain:
    DisplayName: Cinemachine Brain
    Tooltip: Reference to the CinemachineBrain component managing the active virtual cameras.
  CameraShakeControl_controller:
    DisplayName: Core Controller
    Tooltip: Reference to the main SAWController component to read movement and sprint states.
  CameraShakeControl_maxShake:
    DisplayName: Max Shake Amplitude
    Tooltip: The maximum noise amplitude applied to the camera during intense movement or sprinting.
  CameraShakeControl_smoothTime:
    DisplayName: Shake Smooth Time
    Tooltip: The damping time used to smoothly blend camera shake intensity in and out.
  CameraShakeControl_sprintFrequency:
    DisplayName: Sprint Shake Frequency
    Tooltip: The target noise frequency applied to the camera when the character is sprinting.
  CharacterModifierBase_priority:
    DisplayName: Execution Priority
    Tooltip: Determines the evaluation order of this modifier in the pipeline. Higher values are processed before lower values.
  Configuration:
    DisplayName: CONFIGURATION
    Tooltip: The master configuration block for the character controller.
  Crouch:
    DisplayName: Crouch
    Tooltip: Settings controlling crouch mechanics, collider heights, and ceiling checks.
  CrouchSettingsCanCrouch:
    DisplayName: Can Crouch
    Tooltip: Global toggle to enable or disable the crouching mechanic.
  CrouchSettingsCanJumpWhileCrouching:
    DisplayName: Can Jump While Crouching
    Tooltip: Allows the character to perform a full-height jump without needing to stand up first.
  CrouchSettingsCrouchHeight:
    DisplayName: Crouch Height
    Tooltip: The height of the character's capsule collider when in the crouched state.
  CrouchSettingsCrouchSpeed:
    DisplayName: Crouch Speed
    Tooltip: The maximum movement speed allowed while the character is crouching.
  CrouchSettingsEnvironmentMask:
    DisplayName: Ceiling Obstacle Mask
    Tooltip: The LayerMask used to raycast upwards and prevent the character from standing up under low ceilings.
  CrouchSettingsStandingHeight:
    DisplayName: Standing Height
    Tooltip: The default height of the character's capsule collider when standing upright.
  CursorSystem_defaultLockMode:
    DisplayName: Cursor Lock Mode
    Tooltip: The default lock state applied to the mouse cursor when the scene starts.
  CursorSystem_startLocked:
    DisplayName: Lock Cursor on Start
    Tooltip: Automatically hides and locks the mouse cursor to the center of the screen on Awake.
  CursorSystem_toggleAction:
    DisplayName: Toggle Cursor Action
    Tooltip: The Input System action used to toggle the mouse cursor's lock state at runtime.
  DashboardAssignConfig:
    DisplayName: Assign a configuration ScriptableObject to deploy the dashboard.
    Tooltip: Displayed when the main Character Settings slot is empty.
  DashboardCharacterSettingsLabel:
    DisplayName: Character Settings
    Tooltip: The main ScriptableObject containing all core movement and physics data.
  DashboardErrorNoSettingsField:
    DisplayName: 'Error: CharacterSettings field not found in SAWController.'
    Tooltip: Critical inspector error indicating a broken reflection lookup.
  DashboardValidationCrouchHeight:
    DisplayName: 'Logic Error: Crouch height cannot be higher than standing height.'
    Tooltip: Collider geometry validation failure.
  DashboardValidationCrouchSpeed:
    DisplayName: 'Warning: Crouch speed is higher than normal walking speed.'
    Tooltip: Gameplay logic warning.
  DashboardValidationGravity:
    DisplayName: 'Critical: Gravity parameters have positive values. The character will fly away upward.'
    Tooltip: Physics validation failure. Downward forces must be negative.
  DashboardValidationSprint:
    DisplayName: 'Warning: Sprint speed is slower than normal walking speed.'
    Tooltip: Gameplay logic warning.
  DashMechanic_cooldown:
    DisplayName: Dash Cooldown
    Tooltip: The mandatory wait time (in seconds) before the character can execute another dash.
  DashMechanic_dashDuration:
    DisplayName: Dash Duration
    Tooltip: How long (in seconds) the high-velocity dash state remains active.
  DashMechanic_dashSpeed:
    DisplayName: Dash Velocity
    Tooltip: The flat physical speed applied to the character during the dash execution.
  DashMechanic_inputBufferTime:
    DisplayName: Dash Input Buffer
    Tooltip: The time window (in seconds) to cache a dash input if the character is currently unable to dash.
  DashMechanic_key:
    DisplayName: Dash Activation Key
    Tooltip: The legacy KeyCode used to trigger the dash mechanic.
  DynamicFOV_cinemachineCam:
    DisplayName: Target Virtual Camera
    Tooltip: The CinemachineCamera component whose Field of View will be dynamically adjusted.
  DynamicFOV_controller:
    DisplayName: Core Controller
    Tooltip: Reference to the main SAWController component to read current movement velocity.
  DynamicFOV_maxFovOffset:
    DisplayName: Max FOV Expansion
    Tooltip: The maximum additional Field of View added when the character reaches top sprinting speed.
  DynamicFOV_smoothTime:
    DisplayName: FOV Shift Smooth Time
    Tooltip: The damping time used to smoothly interpolate the Field of View changes.
  DynamicFOV_speedMultiplier:
    DisplayName: FOV Velocity Weight
    Tooltip: A multiplier that scales how heavily the current character speed influences the FOV shift.
  Editor_ActiveLangLabel:
    DisplayName: Active Language
    Tooltip: The currently active localization pack for the Unity Editor interface.
  Editor_DocButton:
    DisplayName: "\U0001F4D6 OPEN DOCUMENTATION"
    Tooltip: Opens the official SAWC documentation in your default web browser.
  Editor_DocMessage:
    DisplayName: Select your language below to instantly translate the entire inspector interface. Need help? Check the docs.
    Tooltip: Informational message displayed in the SAWC Hub window.
  Editor_Hello:
    DisplayName: Welcome to SAW Hub
    Tooltip: The main greeting text for the SAWC Hub editor window.
  Editor_InstalledPacksLabel:
    DisplayName: Installed Packages
    Tooltip: Header label for the list of available language packs.
  Jump:
    DisplayName: Jump
    Tooltip: Settings controlling jump force, air control, and buffering.
  JumpSettingsAirControlMultiplier:
    DisplayName: Air Control Multiplier
    Tooltip: A multiplier applied to movement input responsiveness while the character is airborne (0 = no control, 1 = full control).
  JumpSettingsCanJump:
    DisplayName: Can Jump
    Tooltip: Global toggle to enable or disable the jumping mechanic.
  JumpSettingsCeilingBounceVelocity:
    DisplayName: Ceiling Bounce Force
    Tooltip: The downward vertical velocity applied when the character's head hits a ceiling during a jump.
  JumpSettingsCoyoteTime:
    DisplayName: Coyote Time
    Tooltip: The grace period (in seconds) allowing the player to jump after walking off a ledge.
  JumpSettingsEnableAutoJump:
    DisplayName: Enable Auto Jump
    Tooltip: If enabled, holding the jump button will automatically trigger consecutive jumps (Bunny Hop).
  JumpSettingsJumpBufferTime:
    DisplayName: Jump Buffer Time
    Tooltip: The time window (in seconds) to cache a jump input if the character is currently in the air.
  JumpSettingsJumpCooldownDuration:
    DisplayName: Jump Reset Cooldown
    Tooltip: The minimum delay required before another jump can be registered.
  JumpSettingsJumpForce:
    DisplayName: Jump Force
    Tooltip: The initial upward velocity applied to the character when leaving the ground.
  LegacyInputReader_crouchKey:
    DisplayName: Crouch Key
    Tooltip: The legacy KeyCode binding used to hold or toggle the crouch state.
  LegacyInputReader_horAxis:
    DisplayName: Horizontal Axis
    Tooltip: The string name of the legacy Input Manager axis used for left/right movement.
  LegacyInputReader_jumpKey:
    DisplayName: Jump Key
    Tooltip: The legacy KeyCode binding used to trigger a jump action.
  LegacyInputReader_sprintKey:
    DisplayName: Sprint Key
    Tooltip: The legacy KeyCode binding used to hold or toggle the sprint state.
  LegacyInputReader_verAxis:
    DisplayName: Vertical Axis
    Tooltip: The string name of the legacy Input Manager axis used for forward/backward movement.
  MasterInputProvider_deadZone:
    DisplayName: Input Deadzone
    Tooltip: The minimum analog stick magnitude required to register movement input.
  MasterInputProvider_switchThreshold:
    DisplayName: Device Switch Threshold
    Tooltip: The analog stick magnitude required to automatically switch the active input device.
  MobileUIReader_joystick:
    DisplayName: Touch Joystick
    Tooltip: Reference to the UI joystick component used for mobile locomotion.
  MobileUIToggle_detector:
    DisplayName: Platform Detector
    Tooltip: The device detection component used to determine if mobile UI should be visible.
  MobileUIToggle_mobileControlsCanvas:
    DisplayName: Mobile UI Canvas
    Tooltip: The UI Canvas containing all mobile touch controls, toggled based on the active device.
  Movement:
    DisplayName: Movement
    Tooltip: Core settings for locomotion, speeds, and acceleration.
  MovementSettingsAccelerationCurve:
    DisplayName: Acceleration Curve
    Tooltip: The animation curve defining the rate of speed increase over time.
  MovementSettingsAllowedSprintDirections:
    DisplayName: Allowed Sprint Directions
    Tooltip: Restricts the input directions in which the character is allowed to sprint.
  MovementSettingsBaseAcceleration:
    DisplayName: Base Acceleration
    Tooltip: The flat rate at which the character accelerates towards the target move speed.
  MovementSettingsBaseDeceleration:
    DisplayName: Base Deceleration
    Tooltip: The flat rate at which the character slows down when no movement input is provided.
  MovementSettingsCanMove:
    DisplayName: Can Move
    Tooltip: Global toggle to enable or disable basic character locomotion.
  MovementSettingsCanSprint:
    DisplayName: Can Sprint
    Tooltip: Global toggle to enable or disable the sprinting state.
  MovementSettingsDecelerationCurve:
    DisplayName: Deceleration Curve
    Tooltip: The animation curve evaluating the braking dynamics when movement input is released.
  MovementSettingsMinMoveThreshold:
    DisplayName: Min Move Threshold
    Tooltip: The minimum input magnitude required to actually initiate physical movement.
  MovementSettingsMoveSpeed:
    DisplayName: Move Speed
    Tooltip: The target top speed for normal walking locomotion.
  MovementSettingsSprintSpeed:
    DisplayName: Sprint Speed
    Tooltip: The target top speed when the sprint state is active.
  MovementSettingsUseInertia:
    DisplayName: Use Inertia
    Tooltip: If enabled, uses acceleration and deceleration curves instead of instant velocity snapping.
  NewInputReader_crouchAction:
    DisplayName: Crouch Action
    Tooltip: The Input System action mapped to toggle or hold the crouch state.
  NewInputReader_jumpAction:
    DisplayName: Jump Action
    Tooltip: The Input System action mapped to trigger a jump.
  NewInputReader_moveAction:
    DisplayName: Movement Action
    Tooltip: The Vector2 Input System action mapped for multi-directional locomotion.
  NewInputReader_sprintAction:
    DisplayName: Sprint Action
    Tooltip: The Input System action mapped to toggle or hold sprinting.
  Physics:
    DisplayName: Physics
    Tooltip: Custom gravity, terminal velocity, and ground snapping settings.
  PhysicsSettingsFallMultiplier:
    DisplayName: Fall Multiplier
    Tooltip: Scales the gravity force when the character is moving downwards to make falls feel heavier and less floaty.
  PhysicsSettingsGravity:
    DisplayName: Gravity Force
    Tooltip: The constant downward acceleration applied when the character is airborne.
  PhysicsSettingsGroundedGravity:
    DisplayName: Grounded Gravity
    Tooltip: A constant downward force applied when grounded to keep the character snapped to slopes and stairs.
  PhysicsSettingsTerminalVelocity:
    DisplayName: Terminal Velocity
    Tooltip: The absolute maximum downward speed clamp to prevent physics tunneling.
  PhysicsSettingsUseGravity:
    DisplayName: Use Gravity
    Tooltip: Toggles the custom gravity calculations for this controller.
  PlayerAudioController_actionCooldown:
    DisplayName: Action Sound Cooldown
    Tooltip: The minimum time delay (in seconds) required between playing discrete action sounds to prevent overlapping.
  PlayerAudioController_actionSource:
    DisplayName: Action Audio Source
    Tooltip: The dedicated AudioSource component used for playing discrete action sounds like jumps, lands, and crouches.
  PlayerAudioController_antiSpamFactor:
    DisplayName: Footstep Anti-Spam Factor
    Tooltip: A cooldown multiplier applied to the step interval to prevent audio spam when rapidly stopping and starting.
  PlayerAudioController_controller:
    DisplayName: Character Controller
    Tooltip: The core SAWController reference used to track movement states and subscribe to physics events.
  PlayerAudioController_crouchDownSettings:
    DisplayName: Crouch Down Sound
    Tooltip: Audio configuration and clip pool triggered when the character enters the crouched state.
  PlayerAudioController_crouchStepSettings:
    DisplayName: Crouch Footstep Settings
    Tooltip: Audio configuration and clip pool used when the character is moving while crouched.
  PlayerAudioController_crouchUpSettings:
    DisplayName: Stand Up Sound
    Tooltip: Audio configuration and clip pool triggered when the character exits the crouched state and stands up.
  PlayerAudioController_jumpSettings:
    DisplayName: Jump Sound Settings
    Tooltip: Audio configuration and clip pool triggered when the character initiates a jump.
  PlayerAudioController_landSettings:
    DisplayName: Landing Sound Settings
    Tooltip: Audio configuration and clip pool triggered when the character successfully lands on the ground.
  PlayerAudioController_sprintStepSettings:
    DisplayName: Sprint Footstep Settings
    Tooltip: Audio configuration and clip pool used when the character is actively sprinting.
  PlayerAudioController_stepSource:
    DisplayName: Footstep Audio Source
    Tooltip: The dedicated AudioSource component used for playing continuous movement and footstep sounds.
  PlayerAudioController_walkStepSettings:
    DisplayName: Walk Footstep Settings
    Tooltip: Audio configuration and clip pool used when the character is moving at normal walking speed.
  Rotation:
    DisplayName: Rotation
    Tooltip: Character model rotation and orientation settings.
  RotationSettingsMovementRotationSmoothTime:
    DisplayName: Rotation Smooth Time (Movement)
    Tooltip: The damping time for rotating the character model to face the movement direction.
  RotationSettingsRotateWithMovement:
    DisplayName: Rotate With Movement
    Tooltip: If true, the character faces the movement direction. If false, the character faces the camera forward (Strafe mode).
  RotationSettingsStrafeRotationSmoothTime:
    DisplayName: Rotation Smooth Time (Strafe)
    Tooltip: The damping time for smoothing camera-relative orientation in Strafe mode.
  Thresholds:
    DisplayName: Thresholds
    Tooltip: Mathematical boundaries used for Animator transitions and state logic.
  ThresholdSettingsAirStateDebounceTime:
    DisplayName: Air State Debounce Time
    Tooltip: A time buffer to filter out false airborne states caused by uneven terrain.
  ThresholdSettingsFallVelocityThreshold:
    DisplayName: Fall Velocity Threshold
    Tooltip: The negative vertical velocity required to officially trigger the falling state.
  ThresholdSettingsIdleTransitionMultiplier:
    DisplayName: Idle Transition Multiplier
    Tooltip: A multiplier controlling the blend speed when transitioning back to the idle animation.
  ThresholdSettingsInputThreshold:
    DisplayName: Input Threshold
    Tooltip: The deadzone value below which all movement input is treated as zero.
  ThresholdSettingsSprintDirectionThreshold:
    DisplayName: Sprint Direction Threshold
    Tooltip: The maximum angle deviation from the camera forward vector where sprinting is still allowed.
  ThresholdSettingsVelocityThreshold:
    DisplayName: Total Velocity Threshold
    Tooltip: The minimum physical speed required to consider the character as 'moving'.
  ThresholdSettingsVerticalVelocityThreshold:
    DisplayName: Vertical Velocity Threshold
    Tooltip: The Y-axis velocity limit below which the character is considered stably grounded.
  TouchInputReceiver_lookPad:
    DisplayName: Touch Look Pad
    Tooltip: The RectTransform boundary acting as a trackpad for camera rotation on mobile.
  TouchInputReceiver_sensitivity:
    DisplayName: Touch Sensitivity
    Tooltip: The sensitivity multiplier applied to touch delta movements for camera rotation.
  UniversalJoystick_deadZone:
    DisplayName: Joystick Deadzone
    Tooltip: The center radius of the joystick where input is ignored to prevent analog drift.
  UniversalJoystick_handle:
    DisplayName: Joystick Handle
    Tooltip: The RectTransform visual element representing the joystick knob.
  UniversalJoystick_handleLimit:
    DisplayName: Joystick Handle Limit
    Tooltip: The maximum radial distance the joystick handle can travel from its center.