.root-container {
    background-color: #1F1F1F;
    padding: 15px;
    flex-grow: 1;
}

.card {
    background-color: #292929;
    border-width: 1px;
    border-color: #1A1A1A;
    border-radius: 6px;
    padding: 16px;
}

.header-card {
    border-top-width: 3px;
    border-top-color: #FF8C1A;
}

.title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #FFFFFF;
    margin-bottom: 6px;
}

.subtitle {
    font-size: 11px;
    color: #B3B3B3;
    white-space: normal;
    margin-bottom: 16px;
}

.main-button {
    background-color: #2E3840;
    color: #99CCFF;
    -unity-font-style: bold;
    font-size: 11px;
    border-width: 1px;
    border-color: #38444F;
    border-radius: 4px;
    padding: 8px 0;
}

.main-button:hover {
    background-color: #3C4954;
}