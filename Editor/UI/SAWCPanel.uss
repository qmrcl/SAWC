.root-container {
    background-color: #1F1F1F;
    padding: 15px;
    flex-grow: 1;
}

.card {
    background-color: #292929;
    border-width: 1px;
    border-color: #1A1A1A;
    border-radius: 6px;
    padding: 10px;
}

.header-card {
    border-top-width: 3px;
    border-top-color: #FF8C1A;
    margin-bottom: 15px;
}

.loc-card {
    margin-bottom: 12px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.list-scroll {
    flex-grow: 1;
    padding-top: 6px;
    background-color: #242424;
}

.title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #FFFFFF;
    margin-bottom: 4px;
}

.subtitle {
    font-size: 11px;
    color: #B3B3B3;
    white-space: normal;
    margin-bottom: 12px;
}

.badge-title {
    font-size: 9px;
    -unity-font-style: bold;
    color: #808080;
    margin-bottom: 2px;
}

.active-lang-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: #FF8C1A;
}

.section-title {
    -unity-font-style: bold;
    color: #666666;
    font-size: 10px;
    margin-bottom: 4px;
    padding-left: 6px;
}

.main-button {
    background-color: #2E3840;
    color: #99CCFF;
    -unity-font-style: bold;
    font-size: 11px;
    border-width: 1px;
    border-color: #38444F;
    border-radius: 4px;
    padding: 6px 0;
}

.main-button:hover {
    background-color: #3C4954;
}

.language-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
    padding: 4px 6px;
    border-radius: 4px;
}

.language-row:hover {
    background-color: #383838;
}

.lang-active-title {
    color: #FF8C1A;
    -unity-font-style: bold;
}

.lang-filename {
    font-size: 9px;
    color: #666666;
    margin-left: 4px;
}

.activate-btn {
    background-color: #333333;
    color: #FFFFFF;
    font-size: 9px;
    border-width: 1px;
    border-color: #4D4D4D;
    border-radius: 4px;
    padding: 3px 10px;
}

.activate-btn:hover {
    background-color: #FF8C1A;
    color: #000000;
    border-color: #FF8C1A;
}

.active-badge {
    background-color: #264D26;
    color: #66E666;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 8px;
    -unity-font-style: bold;
}